{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOME_SERVER Finding Registry",
  "type": "object",
  "required": ["version", "policy", "findings"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "policy": {
      "type": "object",
      "required": ["canonicalSource", "promotion"],
      "properties": {
        "canonicalSource": { "type": "string" },
        "promotion": { "type": "string" }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "occurrenceKey",
          "title",
          "service",
          "category",
          "severity",
          "occurrenceCount",
          "pullRequests",
          "occurrences"
        ],
        "properties": {
          "occurrenceKey": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "service": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "firstSeenAt": { "type": "string", "format": "date-time" },
          "lastSeenAt": { "type": "string", "format": "date-time" },
          "occurrenceCount": { "type": "integer", "minimum": 1 },
          "pullRequests": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "occurrences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["reviewId", "pullRequest", "reviewedAt", "status"],
              "properties": {
                "reviewId": { "type": "string", "minLength": 1 },
                "pullRequest": { "type": "string", "minLength": 1 },
                "reviewedAt": { "type": "string", "format": "date-time" },
                "status": {
                  "type": "string",
                  "enum": ["open", "accepted", "fixed", "wont-fix", "duplicate"]
                },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
